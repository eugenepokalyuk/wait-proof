# Локально ничего править не нужно: SQLite, DEBUG, пуши выключены.
# На сервере файл живёт в /etc/wait-proof/api.env (права 600), не в репозитории.

DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite — база в файл db.sqlite3; любое другое значение — PostgreSQL по DB_*
DB_ENGINE=sqlite
DB_NAME=waitproof
DB_USER=waitproof
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Откуда браузер пустит запросы к API. Со схемой, без пути и слеша на конце.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Откуда разрешён вход в админку. На сервере: https://168-222-142-117.sslip.io
CSRF_TRUSTED_ORIGINS=

# Куки админки только по https. Локально False, на сервере True.
SECURE_COOKIES=False
SECURE_HSTS_SECONDS=0

# Адрес приложения — из него собираются ссылки-приглашения.
APP_URL=http://localhost:3000

# Web Push. Сгенерировать пару: make vapid. Пусто — пуши не отправляются,
# а попытки пишутся в журнал с пометкой «VAPID не настроен».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для пуш-сервисов: Apple и Google пишут сюда, если с рассылкой что-то
# не так. mailto: или https:.
VAPID_SUBJECT=https://eugenepokalyuk.github.io/wait-proof/

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=60
